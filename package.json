{
  "name": "dinou",
  "version": "8.1.0",
  "description": "Full-stack React 19 framework with native RSC, Server Functions, progressive streaming, and zero vendor lock-in.",
  "type": "module",
  "main": "./dinou/index.js",
  "bin": {
    "dinou": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./dinou/index.d.ts",
      "import": "./dinou/index.js",
      "default": "./dinou/index.js"
    },
    "./env": {
      "types": "./dinou/env.d.ts"
    },
    "./server": {
      "types": "./dinou/server.d.ts",
      "import": "./dinou/server.js",
      "default": "./dinou/server.js"
    },
    "./config": {
      "types": "./dinou/index.d.ts",
      "import": "./dinou/core/config.js",
      "default": "./dinou/core/config.js"
    },
    "./adapters/node": "./dinou/adapters/node.js",
    "./adapters/bun": "./dinou/adapters/bun.js",
    "./adapters/deno": "./dinou/adapters/deno.js",
    "./adapters/cloudflare": "./dinou/adapters/cloudflare.js",
    "./adapters/netlify": "./dinou/adapters/netlify.js"
  },
  "types": "./dinou/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "react-19",
    "react-server-components",
    "rsc",
    "react-server-functions",
    "framework",
    "react-framework",
    "esbuild",
    "rollup",
    "webpack",
    "ssr",
    "streaming",
    "dinou"
  ],
  "author": "Roger Gomez Castells (https://github.com/roggc)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roggc/dinou.git"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.11",
    "@babel/plugin-syntax-import-meta": "7.10.4",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/traverse": "7.29.10",
    "@esbuild-plugins/tsconfig-paths": "0.1.2",
    "@roggc/react-server-dom-esm": "19.3.1",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "28.0.9",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@swc/core": "1.16.20",
    "@tailwindcss/postcss": "4.3.3",
    "autoprefixer": "10.6.1",
    "babel-loader": "10.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "chokidar": "4.0.3",
    "commander": "14.0.3",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "7.0.3",
    "css-loader": "7.1.5",
    "dotenv": "16.6.1",
    "esbuild": "0.27.7",
    "esbuild-copy-static-files": "0.1.0",
    "generic-names": "4.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.31",
    "postcss-import": "16.2.0",
    "postcss-loader": "8.2.1",
    "postcss-modules": "6.0.1",
    "react-refresh": "0.17.0",
    "react-server-dom-webpack": "19.3.1",
    "rollup": "4.65.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-delete": "3.0.2",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-tsconfig-paths": "1.5.2",
    "tailwindcss": "4.3.3",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.7",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "react": ">=19.3.1",
    "react-dom": ">=19.3.1"
  }
}
