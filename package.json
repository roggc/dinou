{
  "name": "dinou",
  "version": "7.0.0",
  "description": "Lightweight-Ejectable Full-Stack React 19 Framework with support for React Server Components (RSC), Server Functions, Server-Side Rendering (SSR), Static Generation (SSG), Incremental Static Generation (ISG), and Incremental Static Regeneration (ISR)",
  "main": "index.js",
  "bin": {
    "dinou": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./dinou/index.d.ts",
      "import": "./dinou/index.mjs",
      "require": "./dinou/index.js"
    },
    "./env": {
      "types": "./dinou/env.d.ts"
    },
    "./server": {
      "types": "./dinou/server.d.ts",
      "import": "./dinou/server.mjs",
      "require": "./dinou/server.js"
    },
    "./config": {
      "types": "./dinou/index.d.ts",
      "import": "./dinou/core/config.js",
      "require": "./dinou/core/config.js"
    },
    "./adapters/node": "./dinou/adapters/node.mjs",
    "./adapters/bun": "./dinou/adapters/bun.js",
    "./adapters/deno": "./dinou/adapters/deno.js",
    "./adapters/cloudflare": "./dinou/adapters/cloudflare.js",
    "./adapters/netlify": "./dinou/adapters/netlify.js"
  },
  "types": "./dinou/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "react-19",
    "react-server-components",
    "rsc",
    "react-server-functions",
    "framework",
    "react-framework",
    "esbuild",
    "rollup",
    "webpack",
    "ssr",
    "streaming",
    "dinou"
  ],
  "author": "Roger Gomez Castells (@roggc)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roggc/dinou.git"
  },
  "dependencies": {
    "@babel/core": "^7.27.4",
    "@babel/parser": "^7.28.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/traverse": "^7.28.3",
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@roggc/react-server-dom-esm": "^19.3.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@swc/core": "^1.15.10",
    "@tailwindcss/postcss": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "dotenv": "^16.5.0",
    "esbuild": "^0.27.0",
    "esbuild-copy-static-files": "^0.1.0",
    "generic-names": "^4.0.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.5",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.0",
    "postcss-modules": "^6.0.1",
    "react-refresh": "^0.17.0",
    "react-server-dom-webpack": "^19.3.0",
    "rollup": "^4.46.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "tailwindcss": "^4.1.10",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  }
}
